{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Agent": {
    "DatabasePath": "",
    "LogDirectory": "",
    "RetainedLogFiles": 14,
    "AdapterNameContains": "",
    "SampleIntervalMs": 1000,
    "ActiveThresholdMbps": 5,
    "StartAfterSeconds": 3,
    "EndAfterSeconds": 10,
    "FlushIntervalSeconds": 5,
    "IdleBaselineSeconds": 60,
    "MaxBufferedSamples": 20000,
    "TrackProcesses": true,
    "ProcessMinBytesPerSec": 10000,
    "MaxRemotesPerProcess": 20,
    "MaxBufferedProcessSamples": 100000,
    "EnableCommandPipe": true,
    "PipeName": "",
    "PendingMarkMinutes": 30,
    "RollupIntervalMinutes": 5,
    "RawRetentionDays": 30,
    "MinuteRollupRetentionDays": 365
  }
}
