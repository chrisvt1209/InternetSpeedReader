@page "/sessions/{Id:long}"
@using Microsoft.Extensions.Options
@using ThroughputMonitor.Web.Data
@inject SessionQueryService Queries
@inject IOptions<WebOptions> Options

<PageTitle>Session @Id - Throughput Monitor</PageTitle>

@if (_loading)
{
    <div class="tm-empty">Loading…</div>
}
else if (_detail is null)
{
    <h1 class="page-title">NOT FOUND</h1>
    <Window Title="error.txt">
        <div class="tm-empty">Session @Id was not found. <a href="">Back to all sessions</a></div>
    </Window>
}
else
{
    var s = _detail.Session;
    bool running = s.EndUtc is null;
    var end = s.EndUtc ?? DateTime.UtcNow;
    double refMbps = Options.Value.ReferenceLinkMbps;
    long programBytes = _detail.Programs.Sum(p => p.RxBytes + p.TxBytes);

    <h1 class="page-title">
        @((s.Label ?? "SESSION " + s.Id).ToUpperInvariant())
        @if (s.Category is not null)
        {
            <span class="tag plain" style="font-family:var(--tm-mono)">@s.Category</span>
        }
        @if (running)
        {
            <span class="tag" style="font-family:var(--tm-mono)">RUNNING</span>
        }
    </h1>
    <p class="page-sub">
        <a href="">← all sessions</a> ·
        @Fmt.LocalDateTime(s.StartUtc) – @(running ? "now" : Fmt.LocalDateTime(s.EndUtc!.Value)) (@Fmt.Duration(end - s.StartUtc))
        · <button class="tm-sort" @onclick="LoadAsync">refresh</button>
    </p>

    <div class="stack">

        @if (!string.IsNullOrWhiteSpace(s.Note))
        {
            <Window Title="note.txt"><span>@s.Note</span></Window>
        }

        <div class="tiles">
            <Window Title="avg_down.exe" Hot="true">
                <div class="big">@Fmt.Mbps(s.AvgRxBps)</div>
                <div class="cap">@Fmt.MBps(s.AvgRxBps)</div>
            </Window>
            <Window Title="peak_down.exe">
                <div class="big">@Fmt.Mbps(s.PeakRxBps)</div>
                <div class="cap">@Fmt.MBps(s.PeakRxBps) · @Fmt.Percent(s.PeakRxBps * 8 / 1e6 / refMbps) of @refMbps.ToString("N0") Mbps</div>
            </Window>
            <Window Title="downloaded.exe">
                <div class="big">@Fmt.Bytes(s.TotalRxBytes)</div>
                <div class="cap">@Fmt.Bytes(s.TotalTxBytes) sent</div>
            </Window>
            <Window Title="upload.exe">
                <div class="big">@Fmt.Mbps(s.AvgTxBps)</div>
                <div class="cap">avg · peak @Fmt.Mbps(s.PeakTxBps)</div>
            </Window>
            <Window Title="machine.exe">
                <div class="big">@s.AvgCpuPercent.ToString("N0")% CPU</div>
                <div class="cap">peak @s.PeakCpuPercent.ToString("N0")% · disk @Fmt.MBps(s.AvgDiskBytesPerSec) (peak @Fmt.MBps(s.PeakDiskBytesPerSec))</div>
            </Window>
            <Window Title="link.exe">
                <div class="big">@Fmt.LinkSpeed(s.MinLinkSpeedBps)</div>
                <div class="cap">lowest link speed during the session</div>
            </Window>
        </div>

        <Window Title="throughput.chart">
            <BarContent>
                <label>
                    <input type="checkbox" @bind="_scaleToLink" />scale to link
                </label>
            </BarContent>
            <ChildContent>
                <ThroughputChart Points="_detail.Points" ReferenceMbps="refMbps" ScaleToReference="_scaleToLink" />
            </ChildContent>
        </Window>

        <div class="two-col">
            <Window Title="programs.log" BodyClass="flush">
                @if (_detail.Programs.Count == 0)
                {
                    <div class="tm-empty">
                        @(running
                            ? "Per-program totals are saved when the session ends."
                            : "No per-program data for this session (the agent was probably not running as administrator).")
                    </div>
                }
                else
                {
                    <div class="tm-table-wrap">
                        <table class="tm-table">
                            <thead>
                                <tr>
                                    <th>program</th>
                                    <th class="num">down</th>
                                    <th class="num">up</th>
                                    <th class="num">peak rx</th>
                                    <th>share</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in _detail.Programs)
                                {
                                    double share = programBytes == 0 ? 0 : (double)(p.RxBytes + p.TxBytes) / programBytes;
                                    <tr>
                                        <td title="@p.ExePath"><strong>@p.ProcessName</strong></td>
                                        <td class="num">@Fmt.Bytes(p.RxBytes)</td>
                                        <td class="num">@Fmt.Bytes(p.TxBytes)</td>
                                        <td class="num">@Fmt.Mbps(p.PeakRxBps)</td>
                                        <td>
                                            <div class="share">
                                                <div class="share-bar"><span style="width:@((share * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span></div>
                                                <span class="share-pct">@Fmt.Percent(share)</span>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </Window>

            <Window Title="remotes.log" BodyClass="flush">
                @if (_detail.Remotes.Count == 0)
                {
                    <div class="tm-empty">No remote address data for this session.</div>
                }
                else
                {
                    <div class="tm-table-wrap">
                        <table class="tm-table">
                            <thead>
                                <tr>
                                    <th>program</th>
                                    <th>remote address</th>
                                    <th class="num">down</th>
                                    <th class="num">up</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in _detail.Remotes)
                                {
                                    <tr>
                                        <td><strong>@r.ProcessName</strong></td>
                                        <td>@(r.RemoteHostName ?? r.RemoteIp)@if (r.RemoteHostName is not null) { <span class="cell-sub">@r.RemoteIp</span> }</td>
                                        <td class="num">@Fmt.Bytes(r.RxBytes)</td>
                                        <td class="num">@Fmt.Bytes(r.TxBytes)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </Window>
        </div>
    </div>
}

@code {
    [Parameter] public long Id { get; set; }

    private SessionDetail? _detail;
    private bool _loading = true;
    private bool _scaleToLink;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = _detail is null;
        _detail = Queries.DatabaseExists ? await Queries.GetDetailAsync(Id) : null;
        _loading = false;
    }
}
