@using System.Globalization
@using ThroughputMonitor.Web.Data

@* Date field with a calendar popup in the app's own window style (the browser's date popup cannot be styled).
   Use with @bind-Value. You can also just type a date. *@

<div class="dp" @onkeydown="OnKeyDown">
    <div class="dp-field">
        <input @key="_inputVersion" id="@Id" type="text" class="form-control form-control-sm dp-input"
               placeholder="@Placeholder" aria-label="@AriaLabel" autocomplete="off"
               value="@_text" @onchange="OnTextChanged" />
        <button type="button" class="dp-open" aria-label="Open calendar" aria-haspopup="dialog" aria-expanded="@_open" @onclick="Toggle">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" /><path d="M3 10h18M8 3v4M16 3v4" /></svg>
        </button>
    </div>

    @if (_open)
    {
        <div class="dp-backdrop" @onclick="Close"></div>
        <div class="win dp-pop" role="dialog" aria-label="Choose a date">
            <header class="win-bar dp-bar">
                <span class="dp-nav">
                    <button type="button" aria-label="Previous year" @onclick="() => MoveMonths(-12)">«</button>
                    <button type="button" aria-label="Previous month" @onclick="() => MoveMonths(-1)">‹</button>
                </span>
                <span class="dp-title">@_view.ToString("MMMM yyyy", Culture)</span>
                <span class="dp-nav">
                    <button type="button" aria-label="Next month" @onclick="() => MoveMonths(1)">›</button>
                    <button type="button" aria-label="Next year" @onclick="() => MoveMonths(12)">»</button>
                </span>
            </header>
            <div class="dp-body">
                <div class="dp-grid dp-head">
                    @foreach (var name in _headers)
                    {
                        <span>@name</span>
                    }
                </div>
                <div class="dp-grid">
                    @foreach (var day in _days)
                    {
                        bool other = day.Month != _view.Month;
                        bool selected = Value is { } v && v.Date == day;
                        bool today = day == Today;
                        <button type="button" class="dp-day @(other ? "other" : "") @(selected ? "selected" : "") @(today ? "today" : "")"
                                aria-label="@day.ToString("D", Culture)" aria-pressed="@selected"
                                @onclick="() => SelectAsync(day)">@day.Day</button>
                    }
                </div>
                <div class="dp-foot">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => SelectAsync(Today)">today</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearAsync">clear</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public DateTime? Value { get; set; }
    [Parameter] public EventCallback<DateTime?> ValueChanged { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public string Placeholder { get; set; } = "dd-mm-yyyy";
    [Parameter] public string? AriaLabel { get; set; }

    private static CultureInfo Culture => CultureInfo.CurrentCulture;
    private static DateTime Today => DateTime.Today;

    private bool _open;
    private string _text = "";
    private int _inputVersion;
    private DateTime _view = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private IReadOnlyList<DateTime> _days = [];
    private IReadOnlyList<string> _headers = [];

    protected override void OnParametersSet()
    {
        _text = Value is { } v ? v.ToString("d", Culture) : "";
    }

    private void Toggle()
    {
        if (_open) { _open = false; return; }

        var shown = Value ?? Today;
        _view = new DateTime(shown.Year, shown.Month, 1);
        Rebuild();
        _open = true;
    }

    private void Close() => _open = false;

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _open = false;
    }

    private void MoveMonths(int months)
    {
        _view = _view.AddMonths(months);
        Rebuild();
    }

    private void Rebuild()
    {
        var first = Culture.DateTimeFormat.FirstDayOfWeek;
        _days = CalendarGrid.Build(_view, first);
        _headers = CalendarGrid.DayHeaders(Culture, first);
    }

    private async Task SelectAsync(DateTime day)
    {
        _open = false;
        await SetAsync(day.Date);
    }

    private async Task ClearAsync()
    {
        _open = false;
        await SetAsync(null);
    }

    private async Task OnTextChanged(ChangeEventArgs e)
    {
        if (DateInput.TryParse(e.Value?.ToString(), Culture, out var parsed))
        {
            await SetAsync(parsed);
        }
        else
        {
            _text = Value is { } v ? v.ToString("d", Culture) : "";
            _inputVersion++;   // a new input element, so the rejected text disappears
        }
    }

    private async Task SetAsync(DateTime? value)
    {
        Value = value;
        _text = value is { } v ? v.ToString("d", Culture) : "";
        await ValueChanged.InvokeAsync(value);
    }
}
